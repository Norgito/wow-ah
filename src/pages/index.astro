				</div>
			</div>

			<!-- Loading State -->
			<div id="loading" class="hidden flex-col justify-center items-center py-16">
				<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-t-2 border-[var(--color-primary)] drop-shadow-[0_0_10px_rgba(124,58,237,0.8)] mb-4"></div>
				<p class="text-[var(--color-primary)] font-heading tracking-widest text-sm animate-pulse">SCANNING...</p>
			</div>

			<!-- Error State -->
			<div id="error" class="hidden bg-[var(--color-destructive)]/20 border border-[var(--color-destructive)] text-[var(--color-foreground)] px-4 py-3 rounded-lg mb-6 backdrop-blur-sm shadow-[0_0_15px_rgba(239,68,68,0.3)]">
				<p class="font-heading tracking-wide uppercase text-[var(--color-destructive)] drop-shadow-[0_0_5px_rgba(239,68,68,0.8)]" id="error-title">Failed to load auctions.</p>
				<p class="text-sm mt-1" id="error-desc">Check your API setup.</p>
			</div>

			<!-- Table -->
			<div class="overflow-x-auto bg-[var(--color-card)] rounded-lg shadow-[0_0_30px_rgba(0,0,0,0.8)] border border-[var(--color-border)] hidden" id="table-container">
				<table class="w-full text-left text-sm whitespace-nowrap">
					<thead class="bg-[var(--color-muted)] border-b border-[var(--color-border)] text-[var(--color-foreground)]">
						<tr>
							<th colspan="3"></th>
							<th colspan="2" class="px-6 pt-4 pb-2">
								<div id="realm-legend" class="flex flex-wrap items-center justify-center gap-5 text-[10px] font-heading uppercase tracking-widest text-[var(--color-muted-foreground)]">
									<span class="text-[var(--color-foreground)] mr-1">Realm Population:</span>
									<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[var(--color-destructive)] shadow-[0_0_5px_rgba(239,68,68,0.8)]"></span> Full</span>
									<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-orange-500 shadow-[0_0_5px_rgba(249,115,22,0.8)]"></span> High</span>
									<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(250,204,21,0.8)]"></span> Med</span>
									<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.8)]"></span> Low</span>
									<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-[0_0_5px_rgba(59,130,246,0.8)]"></span> New</span>
								</div>
							</th>
						</tr>
						<tr>
							<th class="px-6 py-4 font-heading uppercase tracking-wider text-xs">Item</th>
							<th class="px-6 py-4 font-heading uppercase tracking-wider text-xs cursor-pointer hover:text-[var(--color-primary)] hover:drop-shadow-[0_0_5px_rgba(124,58,237,0.8)] select-none group transition-all" onclick="setSort('ilvl')">
								iLvl <span id="sort-icon-ilvl" class="text-[var(--color-primary)] opacity-0 transition-opacity">▼</span>
							</th>
							<th class="px-6 py-4 font-heading uppercase tracking-wider text-xs">Qty</th>
							<th class="px-6 py-4 font-heading uppercase tracking-wider text-xs cursor-pointer hover:text-[var(--color-primary)] hover:drop-shadow-[0_0_5px_rgba(124,58,237,0.8)] select-none group transition-all" onclick="setSort('minBuyout')">
								Buy (Cheapest) <span id="sort-icon-minBuyout" class="text-[var(--color-primary)]">▲</span>
							</th>
							<th class="px-6 py-4 font-heading uppercase tracking-wider text-xs cursor-pointer hover:text-[var(--color-destructive)] hover:drop-shadow-[0_0_5px_rgba(239,68,68,0.8)] select-none group transition-all" onclick="setSort('maxBuyout')">
								Sell (Most Exp.) <span id="sort-icon-maxBuyout" class="text-[var(--color-destructive)] opacity-0 transition-opacity">▼</span>
							</th>
						</tr>
					</thead>
					<tbody id="table-body" class="divide-y divide-[var(--color-border)]">
						<!-- Rows will be injected here via JavaScript -->
					</tbody>
				</table>
			</div>
			
			<!-- Empty State -->
			<div id="empty-state" class="flex flex-col items-center justify-center py-16 text-[var(--color-muted-foreground)]">
				<svg class="w-16 h-16 mb-4 text-[var(--color-border)] drop-shadow-[0_0_10px_rgba(76,29,149,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
				<p class="font-heading tracking-widest text-lg uppercase text-[var(--color-foreground)]" id="empty-title">Search for a BoE item</p>
				<p class="text-sm mt-1" id="empty-desc">Enter an item name to scan across multiple realms.</p>
			</div>
		</main>

		<script>
			let auctions = [];
			let favorites = JSON.parse(localStorage.getItem('wow_ah_favorites') || '[]');
			let isFavoritesView = false;
			let currentSort = 'minBuyout';
			let sortDirection = 'asc';

			window.setSort = function(field) {
				if (currentSort === field) {
					sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
				} else {
					currentSort = field;
					sortDirection = field === 'ilvl' ? 'desc' : 'asc';
				}

				document.getElementById('sort-icon-ilvl').textContent = currentSort === 'ilvl' ? (sortDirection === 'asc' ? '▲' : '▼') : '▼';
				document.getElementById('sort-icon-ilvl').classList.toggle('opacity-0', currentSort !== 'ilvl');
				
				document.getElementById('sort-icon-minBuyout').textContent = currentSort === 'minBuyout' ? (sortDirection === 'asc' ? '▲' : '▼') : '▼';
				document.getElementById('sort-icon-minBuyout').classList.toggle('opacity-0', currentSort !== 'minBuyout');

				document.getElementById('sort-icon-maxBuyout').textContent = currentSort === 'maxBuyout' ? (sortDirection === 'asc' ? '▲' : '▼') : '▼';
				document.getElementById('sort-icon-maxBuyout').classList.toggle('opacity-0', currentSort !== 'maxBuyout');

				renderTable();
			};
			
			const searchInput = document.getElementById('search');
			const searchBtn = document.getElementById('search-btn');
			const realmSelect = document.getElementById('realm');
			const expansionSelect = document.getElementById('expansion');
			const tableBody = document.getElementById('table-body');
			const tableContainer = document.getElementById('table-container');
			const loading = document.getElementById('loading');
			const errorMsg = document.getElementById('error');
			const errorDesc = document.getElementById('error-desc');
			const emptyState = document.getElementById('empty-state');
			const emptyTitle = document.getElementById('empty-title');
			const emptyDesc = document.getElementById('empty-desc');

			function formatMoney(copper) {
				if (!copper) return '-';
				const g = Math.floor(copper / 10000);
				
				if (g > 0) return `<span class="text-yellow-400 font-heading drop-shadow-[0_0_5px_rgba(250,204,21,0.5)] tracking-wide">${g.toLocaleString()}g</span>`;
				return `<span class="text-[var(--color-muted-foreground)] font-heading tracking-wide">< 1g</span>`;
			}
			
			function renderRealmTag(realmString) {
				const match = realmString.match(/^\[(.*?)\] (.*)$/);
				if (!match) return `<span class="text-[11px] text-[var(--color-ring)] ml-3 truncate max-w-[120px]" title="${realmString}">${realmString}</span>`;
				
				const pop = match[1];
				const name = match[2];
				
				let colorClass = 'bg-[var(--color-ring)] shadow-[0_0_5px_rgba(124,58,237,0.8)]';
				if (pop === 'Full') colorClass = 'bg-[var(--color-destructive)] shadow-[0_0_5px_rgba(239,68,68,0.8)]';
				else if (pop === 'High') colorClass = 'bg-orange-500 shadow-[0_0_5px_rgba(249,115,22,0.8)]';
				else if (pop === 'Medium') colorClass = 'bg-yellow-400 shadow-[0_0_5px_rgba(250,204,21,0.8)]';
				else if (pop === 'Low') colorClass = 'bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.8)]';
				else if (pop === 'New' || pop === 'New Players') colorClass = 'bg-blue-500 shadow-[0_0_5px_rgba(59,130,246,0.8)]';

				return `
					<div class="flex items-center ml-3 flex-1 min-w-0 justify-end gap-2" title="${realmString}">
						<span class="w-2 h-2 rounded-full flex-shrink-0 ${colorClass}"></span>
						<span class="text-[11px] text-[var(--color-muted-foreground)] truncate hover:text-[var(--color-foreground)] transition-colors cursor-default text-right max-w-[80px]">${name}</span>
					</div>
				`;
			}

			function renderRealmList(realms) {
				if (!realms || realms.length === 0) {
					return '<span class="text-[var(--color-muted-foreground)] font-heading text-sm">N/A</span>';
				}

				const top = realms[0];
				const rest = realms.slice(1);
				
				let html = `
					<div class="flex justify-between items-center text-sm pb-1.5">
						<span class="shrink-0">${formatMoney(top.price)}</span>
						${renderRealmTag(top.realmName)}
					</div>
				`;

				if (rest.length > 0) {
					html += `
						<button onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.chevron').classList.toggle('rotate-180')" class="w-full text-left text-xs text-[var(--color-muted-foreground)] hover:text-yellow-400 transition-colors flex items-center justify-between py-1.5 mt-1 border-t border-[var(--color-border)] font-heading uppercase tracking-widest focus:outline-none">
							<span>+ ${rest.length} More</span>
							<span class="chevron transition-transform duration-200">▼</span>
						</button>
						<div class="hidden flex-col gap-1.5 mt-1 border-t border-[var(--color-border)]/50 pt-1.5">
							${rest.map(r => `
								<div class="flex justify-between items-center text-sm border-b border-[var(--color-border)]/50 last:border-0 pb-1 last:pb-0">
									<span class="shrink-0">${formatMoney(r.price)}</span>
									${renderRealmTag(r.realmName)}
								</div>
							`).join('')}
						</div>
					`;
				}
				
				return html;
			}

			function renderTable() {
				if (!tableContainer || !emptyState || !tableBody) return;

				if (auctions.length === 0) {
					tableContainer.classList.add('hidden');
					emptyTitle.textContent = "No items found";
					emptyDesc.textContent = "Try a different search term or change your filters.";
					emptyState.classList.remove('hidden');
					return;
				}

				emptyState.classList.add('hidden');
				tableContainer.classList.remove('hidden');

				const sortedAuctions = [...auctions].sort((a, b) => {
					let valA = a[currentSort];
					let valB = b[currentSort];
					
					if (currentSort === 'ilvl') {
						valA = parseInt(valA) || 0;
						valB = parseInt(valB) || 0;
					}
					
					if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
					if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
					return 0;
				});

				tableBody.innerHTML = sortedAuctions.map(auction => `
					<tr class="hover:bg-[var(--color-muted)] transition-all duration-300 group hover:shadow-[0_0_15px_rgba(124,58,237,0.15)] relative z-10 hover:z-20">
						<td class="px-6 py-4">
							<div class="flex items-center gap-4">
								<button class="favorite-toggle flex-shrink-0 text-[var(--color-muted-foreground)] hover:text-yellow-400 hover:drop-shadow-[0_0_8px_rgba(250,204,21,0.8)] focus:outline-none transition-all duration-300" data-id="${auction.id}">
									<svg class="w-6 h-6 ${favorites.includes(auction.id) ? 'text-yellow-400 fill-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.8)]' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
									</svg>
								</button>
								${auction.icon 
									? `<img src="${auction.icon}" alt="${auction.name}" class="w-10 h-10 rounded border border-[var(--color-border)] shadow-sm group-hover:border-[var(--color-primary)] group-hover:shadow-[0_0_10px_rgba(124,58,237,0.5)] transition-all duration-300" />` 
									: `<div class="w-10 h-10 bg-[var(--color-background)] rounded border border-[var(--color-border)] flex items-center justify-center shadow-sm"><span class="text-xs text-[var(--color-muted-foreground)]">?</span></div>`
								}
								<div class="flex flex-col">
									<span class="font-heading tracking-wide text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] cursor-pointer transition-colors">${auction.name}</span>
									<span class="text-xs text-[var(--color-muted-foreground)] mt-0.5">${auction.expansion}</span>
								</div>
							</div>
						</td>
						<td class="px-6 py-4 text-yellow-400 font-heading drop-shadow-[0_0_5px_rgba(250,204,21,0.5)] tracking-wide">${auction.ilvl}</td>
						<td class="px-6 py-4 text-[var(--color-foreground)] font-heading tracking-wide">${auction.quantity || 1}</td>
						<td class="px-6 py-4 align-top">
							<div class="flex flex-col">
								${renderRealmList(auction.top10Cheapest)}
							</div>
						</td>
						<td class="px-6 py-4 align-top">
							<div class="flex flex-col">
								${renderRealmList(auction.top10Expensive)}
							</div>
						</td>
					</tr>
				`).join('');

				// Attach favorite toggle handlers
				document.querySelectorAll('.favorite-toggle').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const id = btn.getAttribute('data-id');
						if (favorites.includes(id)) {
							favorites = favorites.filter(fid => fid !== id);
						} else {
							favorites.push(id);
						}
						localStorage.setItem('wow_ah_favorites', JSON.stringify(favorites));
						
						// If we're in favorites view and unfavorited an item, remove it instantly from the screen
						if (isFavoritesView && !favorites.includes(id)) {
							auctions = auctions.filter(a => a.id !== id);
						}
						renderTable();
					});
				});
			}

			async function fetchFavorites() {
				isFavoritesView = true;
				if (favorites.length === 0) {
					auctions = [];
					renderTable();
					emptyTitle.textContent = "No Favorites Yet";
					emptyDesc.textContent = "Star some items in your searches to see them here.";
					emptyState.classList.remove('hidden');
					return;
				}

				tableContainer.classList.add('hidden');
				emptyState.classList.add('hidden');
				loading.classList.remove('hidden');
				loading.classList.add('flex');

				try {
					const uniqueBaseIds = [...new Set(favorites.map(f => f.startsWith('pet-') ? f.split('-').slice(0, 2).join('-') : f.split('-')[0]))].join(',');
					const realm = realmSelect.value;
					const expansion = expansionSelect.value;
					
					const response = await fetch(`/api/auctions?ids=${uniqueBaseIds}&realm=${realm}&expansion=${expansion}`);
					const data = await response.json();
					
					// Filter to strictly show the specific variant IDs they favorited
					auctions = data.filter(a => favorites.includes(a.id));
					renderTable();
				} catch (error) {
					console.error('Failed to fetch favorites:', error);
				} finally {
					loading.classList.remove('flex');
					loading.classList.add('hidden');
				}
			}

			document.getElementById('favorites-btn')?.addEventListener('click', fetchFavorites);

			async function fetchAuctions() {
				isFavoritesView = false;
				const query = searchInput.value.trim();
				const realm = realmSelect.value;
				const expansion = expansionSelect.value;
				if (!query) return;

				emptyState.classList.add('hidden');
				tableContainer.classList.add('hidden');
				errorMsg.classList.add('hidden');
				loading.classList.remove('hidden');
				loading.classList.add('flex');

				try {
					const response = await fetch('/api/auctions?q=' + encodeURIComponent(query) + '&realm=' + realm + '&expansion=' + encodeURIComponent(expansion));
					const data = await response.json();

					if (!response.ok) {
						throw new Error(data.error || 'Network response was not ok');
					}
					
					auctions = data;
					renderTable();
				} catch (err) {
					errorDesc.textContent = err.message;
					errorMsg.classList.remove('hidden');
					console.error("Failed to fetch auctions", err);
				} finally {
					loading.classList.add('hidden');
					loading.classList.remove('flex');
				}
			}

			const suggestionsBox = document.getElementById('suggestions');
			let activeSuggestionIdx = -1;

			const QUALITY_COLORS = {
				poor: '#94a3b8',
				common: '#f8fafc',
				uncommon: '#22c55e',
				rare: '#3b82f6',
				epic: '#a855f7',
				legendary: '#f97316',
				artifact: '#eab308',
				heirloom: '#06b6d4'
			};

			function escapeHtml(str) {
				if (!str) return '';
				return String(str)
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#039;');
			}

			function updateSuggestionHighlight() {
				const items = suggestionsBox.querySelectorAll('.suggestion-item');
				items.forEach((item, idx) => {
					if (idx === activeSuggestionIdx) {
						item.classList.add('bg-[var(--color-muted)]', 'ring-1', 'ring-inset', 'ring-[var(--color-primary)]');
						item.scrollIntoView({ block: 'nearest' });
					} else {
						item.classList.remove('bg-[var(--color-muted)]', 'ring-1', 'ring-inset', 'ring-[var(--color-primary)]');
					}
				});
			}

			async function fetchSuggestions(query) {
				if (!query || query.length < 3) {
					suggestionsBox.classList.add('hidden');
					return;
				}
				try {
					const response = await fetch('/api/suggestions?q=' + encodeURIComponent(query));
					const data = await response.json();
					if (data && data.length > 0) {
						activeSuggestionIdx = -1;
						suggestionsBox.innerHTML = data.map(s => {
							const qualityColor = (s.quality && QUALITY_COLORS[s.quality]) || 'var(--color-foreground)';
							const safeName = escapeHtml(s.name);
							return `
								<li class="suggestion-item flex items-center gap-3 px-3.5 py-2.5 hover:bg-[var(--color-muted)] cursor-pointer transition-all duration-150 group select-none" data-name="${encodeURIComponent(s.name)}">
									${s.icon 
										? `<img src="${s.icon}" alt="${safeName}" class="w-8 h-8 rounded shrink-0 object-cover shadow-sm transition-all duration-200 group-hover:scale-105 group-hover:shadow-[0_0_8px_rgba(124,58,237,0.5)]" style="border: 1.5px solid ${qualityColor};" loading="lazy" onerror="this.onerror=null; this.src='https://render.worldofwarcraft.com/us/icons/56/inv_misc_questionmark.jpg';" />` 
										: `<div class="w-8 h-8 rounded border border-[var(--color-border)] bg-[var(--color-background)] flex items-center justify-center shrink-0 text-xs text-[var(--color-muted-foreground)]">?</div>`
									}
									<div class="flex items-center justify-between min-w-0 flex-1 gap-2">
										<span class="text-sm font-heading tracking-wide transition-colors truncate" style="color: ${qualityColor};">${safeName}</span>
										${s.isPet ? `<span class="text-[10px] font-heading uppercase tracking-wider text-cyan-400 bg-cyan-950/60 px-1.5 py-0.5 rounded border border-cyan-800/50 shrink-0">Pet</span>` : ''}
									</div>
								</li>
							`;
						}).join('');
						suggestionsBox.classList.remove('hidden');
					} else {
						suggestionsBox.classList.add('hidden');
					}
				} catch (err) {
					console.error(err);
				}
			}

			window.selectSuggestion = function(name) {
				searchInput.value = name;
				suggestionsBox.classList.add('hidden');
				activeSuggestionIdx = -1;
				fetchAuctions();
			};

			suggestionsBox.addEventListener('click', (e) => {
				const item = e.target.closest('.suggestion-item');
				if (item && item.dataset.name) {
					selectSuggestion(decodeURIComponent(item.dataset.name));
				}
			});

			document.addEventListener('click', (e) => {
				if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
					suggestionsBox.classList.add('hidden');
					activeSuggestionIdx = -1;
				}
			});

			searchBtn.addEventListener('click', () => {
				suggestionsBox.classList.add('hidden');
				fetchAuctions();
			});
			
			searchInput.addEventListener('keydown', (e) => {
				if (suggestionsBox.classList.contains('hidden')) {
					if (e.key === 'Enter') {
						fetchAuctions();
					}
					return;
				}

				const items = suggestionsBox.querySelectorAll('.suggestion-item');
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					if (items.length > 0) {
						activeSuggestionIdx = (activeSuggestionIdx + 1) % items.length;
						updateSuggestionHighlight();
					}
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					if (items.length > 0) {
						activeSuggestionIdx = (activeSuggestionIdx - 1 + items.length) % items.length;
						updateSuggestionHighlight();
					}
				} else if (e.key === 'Enter') {
					e.preventDefault();
					if (activeSuggestionIdx >= 0 && items[activeSuggestionIdx]) {
						const name = decodeURIComponent(items[activeSuggestionIdx].dataset.name || '');
						if (name) {
							selectSuggestion(name);
							return;
						}
					}
					suggestionsBox.classList.add('hidden');
					fetchAuctions();
				} else if (e.key === 'Escape') {
					suggestionsBox.classList.add('hidden');
					activeSuggestionIdx = -1;
				}
			});

			let debounceTimer;
			searchInput.addEventListener('input', () => {
				const val = searchInput.value.trim();
				clearTimeout(debounceTimer);
				if (val.length === 0) {
					auctions = [];
					emptyTitle.textContent = "Search for a BoE item";
					emptyDesc.textContent = "Enter an item name to scan across multiple realms.";
					renderTable();
					suggestionsBox.classList.add('hidden');
					return;
				}
				debounceTimer = setTimeout(() => {
					if (val.length >= 3) {
						fetchSuggestions(val);
					}
				}, 400); // 400ms debounce for suggestions
			});

			realmSelect.addEventListener('change', () => {
				if (searchInput.value.trim().length >= 3) {
					suggestionsBox.classList.add('hidden');
					fetchAuctions();
				}
			});

			expansionSelect.addEventListener('change', () => {
				if (searchInput.value.trim().length >= 3) {
					suggestionsBox.classList.add('hidden');
					fetchAuctions();
				}
			});
		</script>
	</body>
</html>
