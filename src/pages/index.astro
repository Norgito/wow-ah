---
import '../styles/global.css';
---

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=Russo+One&display=swap');

	:root {
		--color-primary: #7C3AED;
		--color-on-primary: #FFFFFF;
		--color-secondary: #A78BFA;
		--color-on-secondary: #0F172A;
		--color-accent: #F43F5E;
		--color-on-accent: #000000;
		--color-background: #0F0F23;
		--color-foreground: #E2E8F0;
		--color-card: #1E1C35;
		--color-card-foreground: #E2E8F0;
		--color-muted: #27273B;
		--color-muted-foreground: #94A3B8;
		--color-border: #4C1D95;
		--color-destructive: #EF4444;
		--color-on-destructive: #000000;
		--color-ring: #7C3AED;
	}
	html {
		font-family: 'Chakra Petch', system-ui, sans-serif;
		background: var(--color-background);
		color: var(--color-foreground);
	}
	h1, h2, h3, h4, h5, h6, .font-heading {
		font-family: 'Russo One', sans-serif;
	}
	
	/* Custom slim scrollbar for table cells */
	.custom-scrollbar::-webkit-scrollbar {
		width: 4px;
	}
	.custom-scrollbar::-webkit-scrollbar-track {
		background: rgba(30, 41, 59, 0.5); 
		border-radius: 4px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: rgba(148, 163, 184, 0.3); 
		border-radius: 4px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background: rgba(148, 163, 184, 0.5); 
	}
</style>

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>WoW Cross-Realm BoE Dashboard</title>
	</head>
	<body class="bg-[var(--color-background)] text-[var(--color-foreground)] min-h-screen">
		<main class="container mx-auto px-4 py-8 max-w-6xl">
			<header class="mb-8 border-b border-[var(--color-border)] pb-4">
				<h1 class="text-5xl font-heading text-[var(--color-primary)] drop-shadow-[0_0_10px_rgba(124,58,237,0.8)] tracking-wide mb-2 uppercase">World of Warcraft</h1>
				<h2 class="text-2xl text-[var(--color-foreground)] mt-1 font-heading tracking-wide">Cross-Realm BoE Dashboard</h2>
				<p class="text-[var(--color-muted-foreground)] mt-2">Find the cheapest raid gear and Bind-on-Equip items across multiple realms.</p>
			</header>

			<!-- Controls -->
			<div class="flex flex-col md:flex-row gap-4 mb-6">
				<div class="flex-1 flex gap-2 relative">
					<input 
						type="text" 
						id="search" 
						placeholder="E.g. Signet, Pendant..." 
						class="w-full bg-[var(--color-muted)] border border-[var(--color-border)] rounded-md pl-4 pr-24 py-2 text-[var(--color-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] shadow-sm transition-all duration-300"
						autocomplete="off"
					/>
					<!-- Suggestions Dropdown -->
					<ul id="suggestions" class="absolute z-50 left-0 right-0 top-full mt-1.5 bg-[var(--color-card)]/95 backdrop-blur-md border border-[var(--color-border)] rounded-lg shadow-[0_12px_30px_rgba(0,0,0,0.7)] hidden max-h-80 overflow-y-auto divide-y divide-[var(--color-border)]/40">
					</ul>
					<button id="search-btn" class="absolute inset-y-0 right-0 px-6 bg-[var(--color-primary)] text-[var(--color-on-primary)] font-heading tracking-wide rounded-r-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] hover:shadow-[0_0_15px_rgba(124,58,237,0.8)] hover:brightness-110">
						SEARCH
					</button>
				</div>
				<button id="favorites-btn" class="w-full md:w-auto px-6 py-2 bg-[var(--color-muted)] hover:bg-[var(--color-card)] text-[var(--color-accent)] border border-[var(--color-border)] font-heading tracking-wide rounded-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] flex items-center justify-center gap-2 hover:shadow-[0_0_15px_rgba(244,63,94,0.4)]">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
					FAVORITES
				</button>
				<div class="w-full md:w-auto flex flex-col sm:flex-row gap-2">
					<select id="expansion" class="w-full sm:w-48 bg-[var(--color-muted)] border border-[var(--color-border)] rounded-md px-4 py-2 text-[var(--color-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] shadow-sm transition-colors cursor-pointer">
						<option value="all">All Expansions</option>
						<option value="Midnight">Midnight</option>
						<option value="The War Within">The War Within</option>
						<option value="Dragonflight">Dragonflight</option>
						<option value="Shadowlands">Shadowlands</option>
