						<option value="3694">Lightbringer</option>
						<option value="99">Llane</option>
						<option value="163">Maelstrom</option>
						<option value="78">Magtheridon</option>
						<option value="3684">Mal'Ganis</option>
						<option value="104">Malygos</option>
						<option value="3675">Moon Guard</option>
						<option value="3208">Nemesis</option>
						<option value="5">Proudmoore</option>
						<option value="1428">Quel'Thalas</option>
