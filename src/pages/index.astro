					</select>
					<select id="realm" class="w-full sm:w-48 bg-[var(--color-muted)] border border-[var(--color-border)] rounded-md px-4 py-2 text-[var(--color-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] shadow-sm transition-colors cursor-pointer">
